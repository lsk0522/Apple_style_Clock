<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declared here, not only in the app module: this module is what calls
         setPersisted and runs the foreground service, so it is what depends on
         them. The merger unions these with the app's own. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>

        <!-- Woken by JobScheduler the moment charging starts. A manifest
             receiver for ACTION_POWER_CONNECTED would never fire: that action
             is not on the implicit-broadcast exemption list. -->
        <service
            android:name=".StandbyChargingJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Runs only while the charger is attached. -->
        <service
            android:name=".ChargingMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows a full-screen clock while the device charges, and must observe charging and screen state to know when to present and dismiss it." />
        </service>

        <!-- BOOT_COMPLETED *is* exempt, so this receiver really does run. -->
        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
