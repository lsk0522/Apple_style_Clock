    <!-- Shared -->
    <!-- Warning shown when the second hand is switched on -->
    <string name="seconds_alert_title">Turn on the second hand?</string>
    <string name="seconds_alert_message">A smoothly sweeping hand means redrawing the screen constantly. The display cannot rest at 1Hz, so it uses more power, and left on all night it is not kind to the panel either.\n\nIf you only want a clock, leaving it off is better.</string>
    <string name="seconds_alert_confirm">Turn on</string>
