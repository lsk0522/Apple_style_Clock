    <!-- First run -->
    <string name="setup_title">Before you start</string>
    <string name="setup_intro">Android stops apps from putting themselves on screen or staying alive in the background. The settings below are what let the clock appear on its own while charging.</string>
    <string name="setup_intro_hint">Each one takes you straight to its system screen.</string>

    <string name="setup_required_header">Required</string>
    <string name="setup_required_footer">Both have to be on for this to work. You can skip for now and set them later from the Clock tab.</string>
    <string name="setup_overlay">Display over other apps</string>
    <string name="setup_overlay_why">Without this the clock cannot appear once charging is detected</string>
    <string name="setup_battery">Unrestricted battery use</string>
    <string name="setup_battery_why">Otherwise the system puts the app to sleep and charging never wakes it</string>

    <string name="setup_optional_header">Recommended</string>
    <string name="setup_optional_footer">It works without these, but they make it steadier.</string>
    <string name="setup_notifications">Allow notifications</string>
    <string name="setup_notifications_why">Used to show that the charge watcher is running</string>

