# Signing
# Release keys must never be committed.
*.jks
*.keystore
keystore.properties
# The debug key is the exception: it is deliberately shared so that every CI
# build is signed identically and installs as an update instead of forcing an
# uninstall. It grants nothing -- it never signs a release.
!signing/debug.jks

