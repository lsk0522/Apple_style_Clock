# Copy to keystore.properties and fill in. That file is gitignored.
#
# The release key signs the app's identity on Google Play forever: lose it and
# you cannot update your own app, and anyone who has it can publish as you.
# Keep it off the repo and back it up somewhere you will still have in ten years.
#
# Create one with:
#   keytool -genkeypair -v -keystore nightstand-release.jks \
#           -alias nightstand -keyalg RSA -keysize 4096 -validity 10000

storeFile=/absolute/path/to/nightstand-release.jks
storePassword=
keyAlias=nightstand
keyPassword=
