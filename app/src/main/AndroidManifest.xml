<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ===== StandBy 화면을 백그라운드에서 띄우기 위한 핵심 권한 ===== -->
    <!-- 이 권한이 있어야 충전 감지 후 액티비티를 실행할 수 있다 (plan.md §2-2) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ===== 충전 감지 서비스 ===== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ===== 화면 / 햅틱 ===== -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ===== 배터리 최적화 예외 요청 (삼성 절전 대응) ===== -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- TODO(next): Phase 5 — READ_CALENDAR (캘린더 위젯) -->
    <!-- TODO(next): Phase 9 — com.android.vending.BILLING (후원) -->

    <!-- Night mode reads the room's light level. Not required: a phone
         without one simply never switches to the red palette, and Play
         should not hide the app from it. -->
    <uses-feature
        android:name="android.hardware.sensor.light"
        android:required="false" />

    <application
        android:name=".NightstandApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nightstand">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Nightstand"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
